# Copia este archivo a .env.local y reemplaza los valores con los de tu proyecto de Supabase
# (Project Settings > API en el panel de Supabase)

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# API de Claude (console.anthropic.com > API Keys) — para el tutor de IA (Fase 3 en adelante)
ANTHROPIC_API_KEY=tu-api-key-aqui

# Resend (resend.com) — para el correo real de consentimiento del acudiente (Fase 8).
# Si lo dejas vacío, el flujo sigue funcionando: el enlace se muestra en pantalla en vez
# de enviarse por correo, para que puedas probarlo igual.
RESEND_API_KEY=
RESEND_FROM_EMAIL="preparatorIA <onboarding@resend.dev>"

# URL pública de tu app (usada para construir el enlace de consentimiento).
# En local déjala así; en Vercel cámbiala por tu dominio real.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# En Vercel: agrega estas mismas variables en Project Settings > Environment Variables
