# Copia este archivo a .env.local y reemplaza los valores con los de tu proyecto de Supabase
# (Project Settings > API en el panel de Supabase)

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Clave exclusivamente de servidor para operaciones administrativas de registro educativo.
# Nunca uses el prefijo NEXT_PUBLIC_ ni la expongas al navegador.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

SUPABASE_TEST_STUDENT_EMAIL=
SUPABASE_TEST_STUDENT_PASSWORD=
SUPABASE_TEST_EDUCATOR_EMAIL=
SUPABASE_TEST_EDUCATOR_PASSWORD=

SUPABASE_TEST_SEED_ENABLED=

# API de Gemini (Google AI Studio) — para el tutor de IA (Fase 3 en adelante).
# Consíguela gratis, sin tarjeta de crédito, en https://aistudio.google.com/apikey
# (inicia sesión con una cuenta de Google > "Create API key"). Ver el README para
# el paso a paso completo.
GEMINI_API_KEY=tu-gemini-api-key-aqui

# Proveedor de IA: "gemini" (por defecto), "groq" o "deepseek".
AI_PROVIDER=groq

# API de Groq — obtén una clave en https://console.groq.com/keys usando el plan Free.
# El plan Free no pide método de pago; solo se solicita al subir al plan Developer.
# Si AI_PROVIDER=groq, agrega aquí tu clave de Groq.
GROQ_API_KEY=tu-groq-api-key-aqui

# API de DeepSeek — crea una clave en https://platform.deepseek.com/api_keys.
# El crédito de bienvenida es único y vence a los 30 días; después el uso es de pago.
# Si AI_PROVIDER=deepseek, agrega aquí tu clave de DeepSeek.
DEEPSEEK_API_KEY=tu-deepseek-api-key-aqui

# Resend (resend.com) — para el correo real de consentimiento del acudiente (Fase 8).
# Si lo dejas vacío, el flujo sigue funcionando: el enlace se muestra en pantalla en vez
# de enviarse por correo, para que puedas probarlo igual.
RESEND_API_KEY=
RESEND_FROM_EMAIL="preparatorIA <onboarding@resend.dev>"

# URL pública de tu app (usada para construir el enlace de consentimiento).
# En local déjala así; en Vercel cámbiala por tu dominio real.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# En Vercel: agrega estas mismas variables en Project Settings > Environment Variables
